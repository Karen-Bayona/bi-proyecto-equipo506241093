  <step>
    <name>marca_descarte</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// 1. Cálculo de la tarifa neta sin IVA (aplica 1,19 para H4 y H5)
var tarifa_neta = tarifa_noche;
if (codigo_hotel == 'H4' || codigo_hotel == 'H5') {
    tarifa_neta = tarifa_noche / 1.19;
}

// 2. Validación de descartes y reglas de negocio
var motivo = null;
if (fecha_llegada == null || fecha_fin == null) {
  motivo = "Fecha nula o invalida";
} else if (fecha_fin.getTime() &lt;= fecha_llegada.getTime()) {
  motivo = "Salida &lt;= llegada";
} else if (tarifa_noche == null || tarifa_noche &lt;= 0) {
  motivo = "Tarifa nula o no positiva";
} else if (estado_reserva == "Cancelada") {
  motivo = "Reserva cancelada";
}

var estado = (motivo == null) ? "CARGADO" : "DESCARTADO";</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
